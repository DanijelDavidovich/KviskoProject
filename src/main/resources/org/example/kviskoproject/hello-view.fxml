<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.kviskoproject.KviskoController"
            prefHeight="300" prefWidth="1200">

    <top>
        <VBox fx:id="mainVbox" alignment="CENTER" style="-fx-padding: 50 0 0 0;">
            <Label fx:id="titleText"/>
        </VBox>
<!--        <VBox fx:id="questionTextBox" alignment="CENTER" style="-fx-padding: 50 0 0 0;">-->
<!--            <Label fx:id="questionText" text="Question text"/>-->
<!--        </VBox>-->
    </top>
    <center>
        <VBox>
            <HBox fx:id="initialButtons" alignment="CENTER" spacing="10" style="-fx-padding: 50 0 0 0;">
                <Button fx:id="startBtn" text="Start"   onAction="#startGame" />
                <Button fx:id="rankBtn" text="Ranking List" />
            </HBox>
            <HBox fx:id="answerButtons" alignment="CENTER" spacing="30" style="-fx-padding: 35 0 0 0;">
                <VBox spacing="15">
                    <Button fx:id="ansA" onAction="#clickA" text="a" style="-fx-padding: 6 36;"/>
                    <Button fx:id="ansC" onAction="#clickC" text="c" style="-fx-padding: 6 36;"/>
                </VBox>
                <VBox spacing="15">
                    <Button fx:id="ansB" onAction="#clickB" text="b" style="-fx-padding: 6 36;"/>
                    <Button fx:id="ansD" onAction="#clickD" style="-fx-padding: 6 36;"/>
                </VBox>
            </HBox>
        </VBox>
    </center>
    <bottom>
        <HBox fx:id="jokerBox" alignment="BASELINE_RIGHT" style="-fx-padding: 0 15 15 0;">
            <Button fx:id="jokerBtn" onAction="#jokerClick" text="50:50"/>
        </HBox>
    </bottom>

</BorderPane>
